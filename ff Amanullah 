<!DOCTYPE html>
<html>
<head>
    <title>CORE_SECURITY_HUB_ULTRA_PRO</title>
    <style>
        body { 
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364); 
            color: #00f2ff; 
            font-family: 'Segoe UI', monospace; 
            margin: 0; 
            padding: 20px; 
            min-height: 100vh;
        }
        .dashboard { 
            background: rgba(0, 0, 0, 0.6); 
            border: 1px solid #00f2ff; 
            padding: 25px; 
            max-width: 600px; 
            margin: auto; 
            border-radius: 15px; 
            box-shadow: 0 0 30px rgba(0, 242, 255, 0.3);
        }
        .header { text-align: center; border-bottom: 2px solid #00f2ff; margin-bottom: 25px; padding-bottom: 10px; }
        .input-area { 
            width: 100%; box-sizing: border-box; padding: 15px; 
            background: #1a1a1a; color: #00f2ff; border: 1px solid #00f2ff; 
            border-radius: 8px; margin-bottom: 20px; font-size: 16px;
        }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .btn { 
            padding: 12px; background: rgba(0, 242, 255, 0.1); 
            color: #00f2ff; border: 1px solid #00f2ff; 
            cursor: pointer; font-weight: bold; border-radius: 8px; transition: 0.3s;
        }
        .btn:hover { background: #00f2ff; color: #000; box-shadow: 0 0 15px #00f2ff; }
        #log-panel { 
            margin-top: 25px; padding: 15px; background: #0d0d0d; 
            border: 1px solid #333; height: 180px; overflow-y: auto; 
            font-size: 14px; color: #e0e0e0; border-radius: 8px;
        }
    </style>
</head>
<body>

<div class="dashboard">
    <div class="header"><h2>CYBER_SECURITY_CORE_PRO</h2></div>
    <input type="text" id="target" class="input-area" placeholder="ENTER_TARGET_DATA..." autocomplete="off">
    
    <div class="grid">
        <button class="btn" onclick="execute('PHISHING')">PHISHING SCAN</button>
        <button class="btn" onclick="execute('MALWARE')">MALWARE SCAN</button>
        <button class="btn" onclick="execute('APK_VIRUS')">APK VIRUS SCAN</button>
        <button class="btn" onclick="execute('GMAIL')">GMAIL VALIDATOR</button>
        <button class="btn" onclick="execute('FB_LOGIN')">FB LOGIN TEST</button>
        <button class="btn" onclick="execute('MONEY_SCAN')">MONEY LINK SCAN</button>
        <button class="btn" onclick="execute('WIFI_SEC')">WIFI CHECK</button>
        <button class="btn" onclick="execute('SECURITY_MODE')">ANTI-KEYLOG ACTIVE</button>
    </div>

    <div id="log-panel">SYSTEM_READY...<br>> PRIVACY_MODE: ENABLED</div>
</div>

<script>
function execute(mode) {
    const input = document.getElementById('target').value;
    const log = document.getElementById('log-panel');
    
    if(mode === 'SECURITY_MODE') {
        log.innerHTML += "<br>> SECURITY_MODE: ANTI-KEYLOG ENABLED.";
        return;
    }

    if(!input) { log.innerHTML += "<br>> ERROR: INPUT REQUIRED"; return; }

    log.innerHTML += "<br>> INITIALIZING: " + mode + "...";
    
    setTimeout(() => {
        let result = "";
        let isDanger = false;

        const threats = ["hack", "phish", "virus", "malware", "steal", "crack"];
        isDanger = threats.some(t => input.toLowerCase().includes(t));

        if(mode === 'MONEY_SCAN') {
            const money = ["bkas", "nagad", "rocket", "payment"];
            isDanger = money.some(m => input.toLowerCase().includes(m));
            result = isDanger ? "✘ ALERT: SUSPICIOUS PAYMENT LINK!" : "✔ STATUS: SAFE FINANCIAL LINK.";
        } else {
            result = isDanger ? "✘ ALERT: THREAT DETECTED!" : "✔ STATUS: SAFE - NO THREATS FOUND.";
        }

        log.innerHTML += "<br>> RESULT: " + result + "<br>> PRIVACY: DATA STAYS LOCAL";
        log.scrollTop = log.scrollHeight;
    }, 1500);
}
</script>

</body>
</html>